# Production environment template.
#
# Copy to the host's secret store or a root-owned file with mode 600. Never
# commit real values. Every variable above the fold is checked at startup by
# app/security/config_guard.py, which refuses to start if any is missing or
# still set to a development default.
#
# Generate the three secrets with: python -m scripts.generate_keys

FLASK_ENV=production

# --- Required. The app will not start without these. --------------------
SECRET_KEY=
FIELD_ENCRYPTION_KEYS=
SESSION_COOKIE_SECURE=true

# --- Access -------------------------------------------------------------
# Leave the bootstrap invite off except while creating the first admin, and
# never set it to the development code published in the README.
BOOTSTRAP_INVITE_ENABLED=false
SIGNUP_INVITE_CODE=
DEMO_ACCOUNT_ENABLED=false
DEMO_CASES_ENABLED=false
MFA_REQUIRED_ROLES=admin

# --- Services -----------------------------------------------------------
# The transcription service must not be reachable from the internet.
TRANSCRIPTION_URL=http://127.0.0.1:8080
W3W_API_KEY=

# --- Storage ------------------------------------------------------------
DATABASE_URL=sqlite:////srv/quick-capture/instance/database.db

# --- Backups ------------------------------------------------------------
# Store this key separately from the backup archives themselves.
BACKUP_ENCRYPTION_KEY=
BACKUP_DESTINATION=/var/backups/quick-capture
BACKUP_KEEP=14

# --- Optional tuning (defaults shown) -----------------------------------
# SESSION_IDLE_MINUTES=30
# LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=5
# LOGIN_MAX_ATTEMPTS_PER_IP=20
# LOGIN_LOCKOUT_MINUTES=15
# ACCESS_LOG_DEDUPE_MINUTES=5
# RETENTION_ARCHIVED_CASE_DAYS=2190
# RETENTION_ACCESS_LOG_DAYS=365
# RETENTION_LOGIN_ATTEMPT_DAYS=30
