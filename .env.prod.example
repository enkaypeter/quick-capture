FLASK_ENV=production

SECRET_KEY=
FIELD_ENCRYPTION_KEYS=
SESSION_COOKIE_SECURE=true

BOOTSTRAP_INVITE_ENABLED=true
SIGNUP_INVITE_CODE=
DEMO_ACCOUNT_ENABLED=false
DEMO_CASES_ENABLED=false
# Opt-in to allow demo account/cases in production (demo/PoC only).
ALLOW_DEMO_IN_PRODUCTION=false
# Shared demo login: accept any 6-digit MFA code for the demo account only
# (requires ALLOW_DEMO_IN_PRODUCTION=true).
DEMO_ACCOUNT_SHARED_MFA=false
# Wipe what the demo account created and restore the demo cases every N
# minutes. 0 = off. Manual: python -m scripts.reset_demo --apply
DEMO_RESET_INTERVAL_MINUTES=0
MFA_REQUIRED_ROLES=admin

# --- Services -----------------------------------------------------------
TRANSCRIPTION_URL=http://transcriber:8080
W3W_API_KEY=

# --- Storage ------------------------------------------------------------
DATABASE_URL=sqlite:////app/instance/database.db

BACKUP_ENCRYPTION_KEY=
BACKUP_DESTINATION=/app/instance/backups
BACKUP_KEEP=14
