# Local development only. See docs/operations/deployment.md for production,
# where several of these values are rejected outright.
FLASK_ENV=local
SECRET_KEY=xxxx-xxxx
SIGNUP_INVITE_CODE=sots-dev-invite
BOOTSTRAP_INVITE_ENABLED=true
DEMO_ACCOUNT_ENABLED=true
DEMO_ACCOUNT_EMAIL=demo@quickcapture.local
DEMO_ACCOUNT_PASSWORD=demo-password-123
DEMO_ACCOUNT_FIRST_NAME=Demo
DEMO_CASES_ENABLED=true
# The demo account accepts any 6-digit MFA code (it is shared).
DEMO_ACCOUNT_SHARED_MFA=true
# Nightly HH:MM to wipe what the demo account created. Blank = off.
DEMO_RESET_TIME=
W3W_API_KEY=xxx-xxxx

TRANSCRIPTION_URL=http://transcriber:8080

# Optional locally. Without a key, the encrypted case fields are stored as
# plaintext; production refuses to start without one.
# Generate with: python -m scripts.generate_keys
# FIELD_ENCRYPTION_KEYS=

# Session idle timeout in minutes (default 30).
# SESSION_IDLE_MINUTES=30

# Roles that must enrol in TOTP before using the app (default: admin).
# MFA_REQUIRED_ROLES=admin
